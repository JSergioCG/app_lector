<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" >

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_INTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_INTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature android:name="android.hardware.camera" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fontFamily="twentieth_century"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_logo_image"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_logo_image_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppServicesCE"
        android:usesCleartextTraffic="true"
        tools:targetApi="31" >
        <activity
            android:name=".Activity_Sucursales"
            android:exported="false" />
        <activity
            android:name=".ActivityConfig"
            android:exported="false" />

        <meta-data
            android:name="com.google.android.gms.vision.DEPENDENCIES"
            android:value="barcode" /> <!-- android:theme="@style/Theme.AppServicesCE.NoActionBar" -->
        <activity
            android:name=".PrincipalActivity"
            android:exported="true"
            android:fontFamily="sans-serif-light"
            android:label="Casa Elena"
            android:theme="@style/Theme.AppServicesCE.NoActionBar"
            android:windowSoftInputMode="stateAlwaysHidden" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>